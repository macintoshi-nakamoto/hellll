{
  "requiredCredentials": [
    "apiKey"
  ],
  "auth": {
    "type": "signature",
    "signature": {
      "algorithm": "sha256",
      "template": "payscorp:${requestBody.$auth.amount}:${requestBody.$auth.orderId}:${credentials.apiKey}",
      "position": "query",
      "queryParamName": "signature"
    }
  },
  "webhook": {
    "auth": {
      "type": "signature",
      "signature": {
        "algorithm": "sha256",
        "template": "${requestBody.OutSum}:${requestBody.InvId}:${credentials.apiKey}",
        "signatureField": "$.SignatureValue"
      }
    },
    "amountField": "$.OutSum",
    "statusField": "$.Status",
    "orderIdField": "$.InvId",
    "factAmountField": "$.FactSum",
    "responseTransform": [
      {
        "source": "$.InvId",
        "target": "externalOrderId"
      },
      {
        "source": "$.OutSum",
        "target": "amount",
        "transform": "toNumber"
      },
      {
        "source": "$.FactSum",
        "target": "factAmount",
        "transform": "toNumber"
      },
      {
        "source": "$.Status",
        "target": "status",
        "mapping": "statusMappings.primary"
      },
      {
        "source": "$.PaymentMethod",
        "target": "requisites.paymentType",
        "mapping": "paymentTypes.toInternal"
      },
      {
        "source": "$.Fee",
        "target": "fee",
        "transform": "toNumber"
      }
    ]
  },
